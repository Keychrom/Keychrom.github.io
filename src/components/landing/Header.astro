---
import type { LandingCopy } from '../../i18n/landing';
import ThemeToggle from '../ui/ThemeToggle.svelte';
import MobileMenu from '../ui/MobileMenu.svelte';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const repo = 'https://github.com/Keychrom/Tessa';
const links = [
  { href: '#features', label: copy.nav.features },
  { href: '#layouts', label: copy.nav.layouts },
  { href: '#install', label: copy.nav.install },
  { href: copy.nav.docsHref, label: copy.nav.docs },
  { href: copy.nav.benchmarkHref, label: copy.nav.benchmark },
];
---

<header class="sticky top-0 z-50 pt-3 sm:pt-4">
  <div class="site-container">
    <div class="relative flex items-center justify-between rounded-2xl border border-[var(--tessa-border-soft)] bg-[var(--tessa-bg-soft)]/75 px-3 py-2 shadow-[0_12px_40px_rgba(0,0,0,0.18)] backdrop-blur-xl sm:px-4">
      <a href={copy.lang === 'en' ? '/' : '/ja/'} class="group flex items-center gap-2.5" aria-label="Tessa home">
        <img src="/favicon.svg" alt="" width="30" height="30" class="size-[30px] rounded-lg" />
        <span class="font-display text-[0.95rem] font-semibold tracking-[0.18em] text-[var(--tessa-text)]">TESSA</span>
      </a>

      <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
        {links.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-3 py-2 text-[0.8rem] text-[var(--tessa-muted)] transition hover:bg-[var(--tessa-surface)]/70 hover:text-[var(--tessa-text)]"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-1.5">
        <a
          href={copy.nav.languageHref}
          class="hidden rounded-full border border-[var(--tessa-border-soft)] px-3 py-1.5 text-[0.72rem] font-medium text-[var(--tessa-muted)] transition hover:border-[var(--tessa-border)] hover:text-[var(--tessa-text)] sm:inline-flex"
          hreflang={copy.lang === 'en' ? 'ja' : 'en'}
        >
          {copy.nav.language}
        </a>
        <a
          href={repo}
          class="hidden size-9 place-items-center rounded-full border border-[var(--tessa-border-soft)] text-[var(--tessa-muted)] transition hover:border-[var(--tessa-border)] hover:text-[var(--tessa-text)] sm:grid"
          aria-label="Tessa on GitHub"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .7a11.3 11.3 0 0 0-3.6 22c.6.1.8-.2.8-.5v-2c-3.1.7-3.8-1.3-3.8-1.3-.5-1.3-1.2-1.6-1.2-1.6-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.5-.3-5.1-1.2-5.1-5.5 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-2.9 0 0 1-.3 3.1 1.1a10.8 10.8 0 0 1 5.7 0c2.1-1.5 3.1-1.1 3.1-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.8 1.1 3 0 4.3-2.6 5.2-5.1 5.5.4.3.8 1 .8 2v3c0 .3.2.6.8.5A11.3 11.3 0 0 0 12 .7Z" />
          </svg>
        </a>
        <ThemeToggle label={copy.nav.theme} client:load />
        <MobileMenu copy={copy} repo={repo} client:load />
      </div>
    </div>
  </div>
</header>
