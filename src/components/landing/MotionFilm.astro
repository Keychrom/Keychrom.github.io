---
import type { LandingCopy } from '../../i18n/landing';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
---

<section
  id="motion"
  aria-labelledby="motion-title"
  class="relative scroll-mt-28 overflow-hidden border-y border-[var(--tessa-border-soft)] bg-[var(--tessa-bg-soft)]/40 py-20 sm:py-28"
>
  <div class="grid-field pointer-events-none absolute inset-0 opacity-70"></div>
  <div class="site-container relative">
    <div class="flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-2xl">
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--tessa-accent-2)]">{copy.motion.eyebrow}</p>
        <h2 id="motion-title" class="display mt-4 text-[clamp(2.2rem,5vw,4rem)]">{copy.motion.title}</h2>
        <p class="mt-5 max-w-xl text-[0.98rem] leading-7 text-[var(--tessa-muted)]">{copy.motion.body}</p>
      </div>
      <p class="pill w-fit px-3.5 py-2 font-mono text-[0.62rem] uppercase tracking-[0.14em] text-[var(--tessa-muted)]">
        <span class="size-1.5 rounded-full bg-[var(--tessa-accent)]"></span>
        {copy.motion.duration}
      </p>
    </div>

    <div class="mt-10 sm:mt-12">
      <div class="relative" data-motion-slot>
        <div class="absolute inset-0 rounded-[2rem] bg-[radial-gradient(circle_at_50%_30%,var(--tessa-glow),transparent_65%)] blur-2xl"></div>
        <div data-motion-frame class="motion-frame card relative overflow-hidden p-2 sm:p-3">
          <div class="motion-chrome flex items-center justify-between px-2 py-2">
            <div class="flex items-center gap-1.5" aria-hidden="true">
              <span class="size-2 rounded-full bg-[#e2684f]/80"></span>
              <span class="size-2 rounded-full bg-[#d7b36a]/70"></span>
              <span class="size-2 rounded-full bg-[#6f9f8a]/70"></span>
            </div>
            <span class="font-mono text-[0.62rem] tracking-[0.14em] text-[var(--tessa-faint)]">MOTION · 16:9</span>
          </div>

          <div class="motion-stage relative aspect-video overflow-hidden rounded-[0.8rem] border border-[var(--tessa-border-soft)] bg-[#14213d]">
            <iframe
              src="/motion.html"
              title={copy.motion.iframeTitle}
              aria-describedby="motion-description"
              loading="lazy"
              class="absolute inset-0 size-full"
              data-motion-iframe></iframe>
          </div>

          <div class="motion-chrome flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-1.5 pb-1 pt-3 sm:px-2">
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                data-motion-toggle
                data-label-play={copy.motion.play}
                data-label-pause={copy.motion.pause}
                class="inline-flex items-center gap-2 rounded-full bg-[var(--tessa-accent)] px-4 py-2 text-[0.78rem] font-semibold text-[#fff8f4] transition hover:bg-[var(--tessa-accent-2)]"
              >
                <svg data-motion-play-icon class="size-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M4.2 2.6a.9.9 0 0 1 1.36-.78l7.7 4.6a.9.9 0 0 1 0 1.55l-7.7 4.6a.9.9 0 0 1-1.36-.78Z" />
                </svg>
                <svg data-motion-pause-icon class="hidden size-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <rect x="3.5" y="2.5" width="3.2" height="11" rx="1" />
                  <rect x="9.3" y="2.5" width="3.2" height="11" rx="1" />
                </svg>
                <span data-motion-label>{copy.motion.play}</span>
              </button>
              <button
                type="button"
                data-motion-restart
                class="inline-flex items-center gap-2 rounded-full border border-[var(--tessa-border-soft)] px-3.5 py-2 text-[0.78rem] font-medium text-[var(--tessa-muted)] transition hover:border-[var(--tessa-border)] hover:text-[var(--tessa-text)]"
              >
                <svg class="size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2.6 8a5.4 5.4 0 1 0 1.7-4" />
                  <path d="M2.2 2.2v3.4h3.4" />
                </svg>
                {copy.motion.replay}
              </button>
            </div>

            <div class="flex items-center gap-4">
              <span class="hidden font-mono text-[0.62rem] tracking-[0.08em] text-[var(--tessa-faint)] sm:inline">{copy.motion.hint}</span>
              <button
                type="button"
                data-motion-fullscreen
                data-label-fullscreen={copy.motion.fullscreen}
                data-label-exit-fullscreen={copy.motion.exitFullscreen}
                class="inline-flex items-center gap-1.5 text-[0.72rem] font-medium text-[var(--tessa-muted)] transition hover:text-[var(--tessa-text)]"
              >
                <svg class="size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 2H2v4M10 2h4v4M6 14H2v-4M10 14h4v-4" />
                </svg>
                <span data-motion-fullscreen-label>{copy.motion.fullscreen}</span>
              </button>
            </div>
          </div>

          <button
            type="button"
            data-motion-theater-close
            aria-label={copy.motion.exitFullscreen}
            class="motion-theater-close absolute right-4 top-4 z-10 items-center gap-2 rounded-full border border-white/20 bg-black/45 px-3.5 py-2 text-xs font-medium text-white backdrop-blur transition hover:bg-black/70"
          >
            <svg class="size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <path d="M4 4l8 8M12 4l-8 8" />
            </svg>
            {copy.motion.exitFullscreen}
          </button>
        </div>
      </div>
      <p id="motion-description" class="sr-only">{copy.motion.description}</p>
    </div>
  </div>
</section>

<style>
  .motion-theater-close {
    display: none;
  }

  .motion-frame.is-theater {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    width: 100vw;
    height: 100vh;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: #070a12;
  }

  .motion-frame.is-theater .motion-chrome {
    display: none;
  }

  .motion-frame.is-theater .motion-stage {
    width: min(100vw, calc(100vh * 16 / 9));
    flex: none;
    border: 0;
    border-radius: 0;
  }

  .motion-frame.is-theater .motion-theater-close {
    display: inline-flex;
  }

  :global(body.motion-theater) {
    overflow: hidden;
  }

  :global(body.motion-theater main) {
    z-index: 100;
  }
</style>

<script>
  const frame = document.querySelector<HTMLElement>('[data-motion-frame]');
  const iframe = document.querySelector<HTMLIFrameElement>('[data-motion-iframe]');

  if (frame && iframe) {
    const toggle = frame.querySelector<HTMLButtonElement>('[data-motion-toggle]');
    const restart = frame.querySelector<HTMLButtonElement>('[data-motion-restart]');
    const fullscreen = frame.querySelector<HTMLButtonElement>('[data-motion-fullscreen]');
    const label = frame.querySelector<HTMLElement>('[data-motion-label]');
    const playIcon = frame.querySelector<SVGElement>('[data-motion-play-icon]');
    const pauseIcon = frame.querySelector<SVGElement>('[data-motion-pause-icon]');
    const fullscreenLabel = frame.querySelector<HTMLElement>('[data-motion-fullscreen-label]');
    const playLabel = toggle?.dataset.labelPlay ?? 'Play';
    const pauseLabel = toggle?.dataset.labelPause ?? 'Pause';
    let ready = false;
    let playOnReady = false;

    const post = (action: string) => {
      iframe.contentWindow?.postMessage({ type: 'tessa-motion', action }, '*');
    };

    const setPlaying = (next: boolean) => {
      if (label) label.textContent = next ? pauseLabel : playLabel;
      playIcon?.classList.toggle('hidden', next);
      pauseIcon?.classList.toggle('hidden', !next);
      toggle?.setAttribute('aria-label', next ? pauseLabel : playLabel);
    };

    const requestPlay = () => {
      if (ready) post('play');
      else playOnReady = true;
    };

    iframe.addEventListener('load', () => {
      ready = true;
      post('state');
      if (playOnReady) {
        playOnReady = false;
        post('play');
      }
    });

    if (iframe.contentDocument?.readyState === 'complete') {
      ready = true;
      post('state');
    }

    window.addEventListener('message', (event) => {
      if (event.source !== iframe.contentWindow) return;
      const data = event.data as { type?: string; event?: string; playing?: boolean } | null;
      if (!data || data.type !== 'tessa-motion' || data.event !== 'state') return;
      setPlaying(Boolean(data.playing));
    });

    toggle?.addEventListener('click', () => post('toggle'));
    restart?.addEventListener('click', () => post('restart'));

    if (fullscreen && toggle) {
      const theaterClose = frame.querySelector<HTMLButtonElement>('[data-motion-theater-close]');
      const slot = frame.parentElement as HTMLElement | null;
      let savedScroll = 0;
      const setTheater = (on: boolean) => {
        if (on) {
          savedScroll = window.scrollY;
          if (slot) slot.style.minHeight = `${slot.getBoundingClientRect().height}px`;
        }
        frame.classList.toggle('is-theater', on);
        document.body.classList.toggle('motion-theater', on);
        fullscreen.setAttribute('aria-expanded', String(on));
        if (fullscreenLabel) {
          fullscreenLabel.textContent = on
            ? (fullscreen.dataset.labelExitFullscreen ?? 'Exit full screen')
            : (fullscreen.dataset.labelFullscreen ?? 'Full screen');
        }
        if (on) {
          theaterClose?.focus({ preventScroll: true });
        } else {
          if (slot) slot.style.minHeight = '';
          requestAnimationFrame(() => {
            window.scrollTo(0, savedScroll);
            fullscreen.focus({ preventScroll: true });
          });
        }
      };

      fullscreen.addEventListener('click', () => {
        setTheater(!frame.classList.contains('is-theater'));
      });
      theaterClose?.addEventListener('click', () => setTheater(false));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && frame.classList.contains('is-theater')) {
          setTheater(false);
        }
      });
    } else {
      fullscreen?.remove();
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducedMotion) {
      const section = document.getElementById('motion');
      if (section) {
        let started = false;
        let observer: IntersectionObserver | undefined;
        const start = () => {
          if (started) return;
          const rect = section.getBoundingClientRect();
          const visible = Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0);
          if (visible < Math.min(rect.height, window.innerHeight) * 0.35) return;
          started = true;
          observer?.disconnect();
          window.removeEventListener('scroll', start);
          window.removeEventListener('resize', start);
          requestPlay();
        };

        if ('IntersectionObserver' in window) {
          observer = new IntersectionObserver(
            (entries) => {
              if (entries.some((entry) => entry.isIntersecting)) start();
            },
            { threshold: [0, 0.2, 0.35] },
          );
          observer.observe(section);
        }
        window.addEventListener('scroll', start, { passive: true });
        window.addEventListener('resize', start);
        start();
      } else {
        requestPlay();
      }
    }
  }
</script>
