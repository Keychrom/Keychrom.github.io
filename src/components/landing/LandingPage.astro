---
import { landing, type LandingLocale } from '../../i18n/landing';
import LayoutPreview from '../landing/LayoutPreview.svelte';
import InstallTabs from '../landing/InstallTabs.svelte';
import BenchmarkSpark from '../landing/BenchmarkSpark.svelte';

interface Props {
  locale: LandingLocale;
}

const { locale } = Astro.props;
const copy = landing[locale];
const docsHref = copy.nav.docsHref;
const quickstartHref = copy.nav.quickstartHref;
const installHref =
  locale === 'ja' ? '/ja/docs/guide/#2-インストールまたはビルド' : '/docs/guide/#2-install-or-build';
const repo = 'https://github.com/Keychrom/Tessa';
const features = copy.features.items;
const spans = ['md:col-span-4', 'md:col-span-2', 'md:col-span-2', 'md:col-span-2', 'md:col-span-2', 'md:col-span-6'];
---

<section class="relative overflow-hidden pb-16 pt-12 sm:pb-24 sm:pt-20">
  <div class="grid-field pointer-events-none absolute inset-x-0 top-0 h-[42rem] opacity-80"></div>
  <div class="site-container relative grid gap-12 lg:grid-cols-[1.03fr_0.97fr] lg:items-center">
    <div>
      <p class="pill inline-flex px-3 py-1.5 font-mono text-[0.66rem] uppercase tracking-[0.16em] text-[var(--tessa-accent-2)]">
        <span class="size-1.5 rounded-full bg-[var(--tessa-accent)]"></span>
        {copy.hero.eyebrow}
      </p>
      <h1 class="display mt-6 text-[clamp(3.2rem,8vw,6.8rem)] text-[var(--tessa-text)]">
        {copy.hero.titleA}<br />
        <span class="accent-text">{copy.hero.titleB}</span>
      </h1>
      <p class="mt-7 max-w-xl text-[0.98rem] leading-7 text-[var(--tessa-muted)] sm:text-[1.05rem]">
        {copy.hero.body}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={quickstartHref}
          class="inline-flex items-center gap-2 rounded-full bg-[var(--tessa-accent)] px-5 py-3 text-sm font-semibold text-[#fff8f4] shadow-[0_10px_36px_var(--tessa-glow)] transition hover:-translate-y-0.5 hover:bg-[var(--tessa-accent-2)]"
        >
          {copy.hero.primary}
          <svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href={repo}
          class="inline-flex items-center gap-2 rounded-full border border-[var(--tessa-border-soft)] bg-[var(--tessa-surface)]/40 px-5 py-3 text-sm font-semibold text-[var(--tessa-text)] transition hover:border-[var(--tessa-border)] hover:bg-[var(--tessa-surface)]/70"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .7a11.3 11.3 0 0 0-3.6 22c.6.1.8-.2.8-.5v-2c-3.1.7-3.8-1.3-3.8-1.3-.5-1.3-1.2-1.6-1.2-1.6-1-.7.1-.7.1-.7 1.1.1 1.7 1.1 1.7 1.1 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.5-.3-5.1-1.2-5.1-5.5 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-2.9 0 0 1-.3 3.1 1.1a10.8 10.8 0 0 1 5.7 0c2.1-1.5 3.1-1.1 3.1-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.8 1.1 3 0 4.3-2.6 5.2-5.1 5.5.4.3.8 1 .8 2v3c0 .3.2.6.8.5A11.3 11.3 0 0 0 12 .7Z" />
          </svg>
          {copy.hero.secondary}
        </a>
      </div>
      <p class="mt-5 font-mono text-[0.64rem] uppercase tracking-[0.14em] text-[var(--tessa-faint)]">{copy.hero.note}</p>
    </div>

    <div class="relative">
      <div class="absolute inset-0 rounded-[2rem] bg-[radial-gradient(circle_at_55%_35%,var(--tessa-glow),transparent_65%)] blur-2xl"></div>
      <div class="card relative overflow-hidden p-2">
        <div class="flex items-center justify-between px-3 py-2">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="size-2 rounded-full bg-[#f08a72]/80"></span>
            <span class="size-2 rounded-full bg-[#d7b36a]/70"></span>
            <span class="size-2 rounded-full bg-[#6f9f8a]/70"></span>
          </div>
          <span class="font-mono text-[0.62rem] tracking-[0.14em] text-[var(--tessa-faint)]">MOSAIC · 1920×1080</span>
        </div>
        <img
          src="/images/mosaic.png"
          alt="Tessa running a mosaic layout with terminal windows"
          width="1920"
          height="1080"
          class="w-full rounded-[0.8rem] border border-[var(--tessa-border-soft)] object-cover"
        />
      </div>
      <div class="pill absolute -bottom-5 left-5 px-3 py-2 font-mono text-[0.62rem] tracking-[0.1em] text-[var(--tessa-muted)]">
        <span class="size-1.5 rounded-full bg-[var(--tessa-accent)]"></span>
        {locale === 'ja' ? '実セッション · eDP-1' : 'live session · eDP-1'}
      </div>
    </div>
  </div>
</section>

<section class="border-y border-[var(--tessa-border-soft)] bg-[var(--tessa-bg-soft)]/45">
  <div class="site-container grid grid-cols-2 divide-x divide-[var(--tessa-border-soft)] md:grid-cols-4">
    {copy.stats.map((stat, i) => (
      <div class:list={['px-4 py-7 sm:px-6', i < 2 ? 'border-b border-[var(--tessa-border-soft)] md:border-b-0' : '']}>
        <p class="font-display text-3xl font-semibold tracking-[-0.04em] text-[var(--tessa-text)]">
          {stat.value}<span class="ml-1 text-sm font-normal text-[var(--tessa-accent-2)]">{stat.unit}</span>
        </p>
        <p class="mt-1 text-[0.7rem] leading-5 text-[var(--tessa-faint)]">{stat.label}</p>
      </div>
    ))}
  </div>
</section>

<section id="features" class="scroll-mt-28 py-20 sm:py-28">
  <div class="site-container">
    <div class="max-w-2xl">
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--tessa-accent-2)]">{copy.features.eyebrow}</p>
      <h2 class="display mt-4 text-[clamp(2.2rem,5vw,4rem)]">{copy.features.title}</h2>
      <p class="mt-5 text-[0.98rem] leading-7 text-[var(--tessa-muted)]">{copy.features.body}</p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-6">
      {features.map((feature, i) => (
        <article
          data-spotlight
          class:list={['card card-spotlight group flex min-h-[13rem] flex-col justify-between p-6', spans[i]]}
        >
          <div class="flex items-start justify-between gap-4">
            <span class="font-mono text-[0.65rem] tracking-[0.16em] text-[var(--tessa-accent-2)]/80">{String(i + 1).padStart(2, '0')}</span>
            <span class="h-px w-12 bg-[var(--tessa-border)]"></span>
          </div>
          <div class="mt-10">
            <p class="font-mono text-[0.62rem] uppercase tracking-[0.16em] text-[var(--tessa-faint)]">{feature.kicker}</p>
            <h3 class="mt-2 font-display text-2xl font-medium tracking-[-0.03em] text-[var(--tessa-text)]">{feature.title}</h3>
            <p class="mt-3 max-w-xl text-sm leading-6 text-[var(--tessa-muted)]">{feature.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="layouts" class="scroll-mt-28 border-y border-[var(--tessa-border-soft)] bg-[var(--tessa-bg-soft)]/35 py-20 sm:py-28">
  <div class="site-container grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
    <div>
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--tessa-accent-2)]">{copy.layout.eyebrow}</p>
      <h2 class="display mt-4 text-[clamp(2.2rem,5vw,4rem)]">{copy.layout.title}</h2>
      <p class="mt-5 max-w-lg text-[0.98rem] leading-7 text-[var(--tessa-muted)]">{copy.layout.body}</p>
      <ul class="mt-8 grid max-w-md gap-2 text-sm text-[var(--tessa-muted)] sm:grid-cols-2">
        {['master', 'mosaic', 'grid', 'columns', 'scrolling', 'monocle'].map((id) => (
          <li class="flex items-center gap-2.5 rounded-lg border border-[var(--tessa-border-soft)] bg-[var(--tessa-surface)]/30 px-3 py-2">
            <span class="size-1.5 rounded-full bg-[var(--tessa-accent)]"></span>
            {copy.layout.labels[id as keyof typeof copy.layout.labels]}
          </li>
        ))}
      </ul>
      <p class="mt-6 font-mono text-[0.64rem] tracking-[0.12em] text-[var(--tessa-faint)]">{copy.layout.hint}</p>
    </div>
    <LayoutPreview copy={copy} client:visible />
  </div>
</section>

<section class="py-20 sm:py-28">
  <div class="site-container">
    <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--tessa-accent-2)]">{copy.showcase.eyebrow}</p>
        <h2 class="display mt-4 text-[clamp(2.2rem,5vw,4rem)]">{copy.showcase.title}</h2>
      </div>
      <p class="max-w-sm text-sm leading-6 text-[var(--tessa-muted)]">{copy.showcase.body}</p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {copy.showcase.shots.map((shot, i) => (
        <figure class:list={['group overflow-hidden rounded-2xl border border-[var(--tessa-border-soft)] bg-[var(--tessa-surface)]/30', i === 0 || i === 3 ? 'md:col-span-2' : '']}>
          <div class="overflow-hidden">
            <img
              src={shot.src}
              alt={shot.alt}
              loading="lazy"
              width="1920"
              height="1080"
              class:list={['w-full object-cover transition duration-700 group-hover:scale-[1.02]', i === 3 ? 'aspect-[2.6/1]' : 'aspect-[16/10]']}
            />
          </div>
          <figcaption class="flex items-center justify-between px-5 py-3.5">
            <span class="text-sm font-medium text-[var(--tessa-text)]">{shot.title}</span>
            <span class="font-mono text-[0.6rem] uppercase tracking-[0.14em] text-[var(--tessa-faint)]">Tessa Panel</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section id="benchmark" class="scroll-mt-28 border-y border-[var(--tessa-border-soft)] bg-[var(--tessa-bg-soft)]/40 py-20 sm:py-24">
  <div class="site-container grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
    <div>
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--tessa-accent-2)]">{copy.benchmark.eyebrow}</p>
      <h2 class="display mt-4 text-[clamp(2rem,4.5vw,3.5rem)]">{copy.benchmark.title}</h2>
      <p class="mt-5 max-w-lg text-sm leading-7 text-[var(--tessa-muted)]">{copy.benchmark.body}</p>
      <a href={copy.nav.benchmarkHref} class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--tessa-accent-2)] hover:text-[var(--tessa-accent-3)]">
        {copy.benchmark.cta}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="card p-6 sm:p-7">
      <BenchmarkSpark copy={copy} client:visible />
      <p class="mt-6 border-t border-[var(--tessa-border-soft)] pt-4 font-mono text-[0.62rem] leading-5 tracking-[0.08em] text-[var(--tessa-faint)]">
        wayland-compositor-bench 0.6.1 · i5-6300U · Intel HD 520 · 1920×1080@59.93 Hz
      </p>
    </div>
  </div>
</section>

<section id="install" class="scroll-mt-28 py-20 sm:py-28">
  <div class="site-container grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
    <div>
      <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--tessa-accent-2)]">{copy.install.eyebrow}</p>
      <h2 class="display mt-4 text-[clamp(2.2rem,5vw,4rem)]">{copy.install.title}</h2>
      <p class="mt-5 max-w-lg text-[0.98rem] leading-7 text-[var(--tessa-muted)]">{copy.install.body}</p>
      <a href={installHref} class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-[var(--tessa-accent-2)] hover:text-[var(--tessa-accent-3)]">
        {locale === 'ja' ? '詳しい手順を見る' : 'Read the full install guide'} <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="card min-w-0 p-5 sm:p-6">
      <InstallTabs copy={copy} client:visible />
    </div>
  </div>
</section>

<section class="border-t border-[var(--tessa-border-soft)] py-20 sm:py-28">
  <div class="site-container">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div>
        <p class="font-mono text-[0.66rem] uppercase tracking-[0.18em] text-[var(--tessa-accent-2)]">{copy.docs.eyebrow}</p>
        <h2 class="display mt-4 text-[clamp(2.2rem,5vw,4rem)]">{copy.docs.title}</h2>
        <p class="mt-5 max-w-lg text-[0.98rem] leading-7 text-[var(--tessa-muted)]">{copy.docs.body}</p>
        <a href={docsHref} class="mt-7 inline-flex items-center gap-2 rounded-full bg-[var(--tessa-accent)] px-5 py-3 text-sm font-semibold text-[#fff8f4] transition hover:bg-[var(--tessa-accent-2)]">
          {copy.docs.cta}
          <svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
      <div class="grid gap-3">
        {copy.docs.cards.map((card) => (
          <a href={card.href} class="group flex items-center justify-between gap-5 rounded-xl border border-[var(--tessa-border-soft)] bg-[var(--tessa-surface)]/25 px-5 py-4 transition hover:border-[var(--tessa-border)] hover:bg-[var(--tessa-surface)]/50">
            <span>
              <span class="block text-sm font-semibold text-[var(--tessa-text)]">{card.title}</span>
              <span class="mt-1 block text-xs leading-5 text-[var(--tessa-muted)]">{card.body}</span>
            </span>
            <span class="text-[var(--tessa-accent-2)] transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll<HTMLElement>('[data-spotlight]');
  for (const card of cards) {
    card.addEventListener('pointermove', (event) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--spot-x', `${event.clientX - rect.left}px`);
      card.style.setProperty('--spot-y', `${event.clientY - rect.top}px`);
    });
  }
</script>
