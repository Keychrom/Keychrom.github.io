---
import type { LandingCopy } from '../../i18n/landing';

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const year = new Date().getFullYear();
const repo = 'https://github.com/Keychrom/Tessa';
---

<footer class="border-t border-[var(--tessa-border-soft)] pb-10 pt-12">
  <div class="site-container">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="max-w-sm">
        <a href={copy.lang === 'en' ? '/' : '/ja/'} class="flex items-center gap-2.5">
          <img src="/favicon.svg" alt="" width="28" height="28" class="size-7 rounded-lg" />
          <span class="font-display text-sm font-semibold tracking-[0.18em]">TESSA</span>
        </a>
        <p class="mt-4 text-sm leading-6 text-[var(--tessa-muted)]">{copy.footer.blurb}</p>
        <p class="mt-4 font-mono text-[0.66rem] tracking-[0.12em] text-[var(--tessa-faint)]">
          wlroots · Zig · Wayland
        </p>
      </div>

      <div>
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--tessa-faint)]">{copy.footer.project}</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-[var(--tessa-muted)] hover:text-[var(--tessa-text)]" href={repo}>GitHub</a></li>
          <li><a class="text-[var(--tessa-muted)] hover:text-[var(--tessa-text)]" href={copy.nav.benchmarkHref}>{copy.nav.benchmark}</a></li>
          <li><a class="text-[var(--tessa-muted)] hover:text-[var(--tessa-text)]" href={copy.lang === 'en' ? '/docs/roadmap/' : '/ja/docs/roadmap/'}>{copy.footer.roadmap}</a></li>
        </ul>
      </div>

      <div>
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--tessa-faint)]">{copy.footer.docs}</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-[var(--tessa-muted)] hover:text-[var(--tessa-text)]" href={copy.nav.docsHref}>{copy.nav.docs}</a></li>
          <li><a class="text-[var(--tessa-muted)] hover:text-[var(--tessa-text)]" href={copy.lang === 'en' ? '/docs/guide/' : '/ja/docs/guide/'}>{copy.footer.guide}</a></li>
          <li><a class="text-[var(--tessa-muted)] hover:text-[var(--tessa-text)]" href={copy.lang === 'en' ? '/docs/extension-api/' : '/ja/docs/extension-api/'}>{copy.footer.extensionApi}</a></li>
        </ul>
      </div>

      <div>
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-[var(--tessa-faint)]">{copy.footer.source}</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="text-[var(--tessa-muted)] hover:text-[var(--tessa-text)]" href={repo}>{copy.footer.repository}</a></li>
          <li><a class="text-[var(--tessa-muted)] hover:text-[var(--tessa-text)]" href={`${repo}/issues`}>{copy.footer.issues}</a></li>
          <li><a class="text-[var(--tessa-muted)] hover:text-[var(--tessa-text)]" href={`${repo}/blob/main/LICENSE`}>{copy.footer.license}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-[var(--tessa-border-soft)] pt-5 text-[0.7rem] text-[var(--tessa-faint)] sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Keychrom · {copy.footer.license}</p>
      <p>{copy.footer.built}</p>
    </div>
  </div>
</footer>
